# Copy this file to .env and replace the placeholder with your own key.
# Keep .env local and never commit it.
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Optional local Ollama model for scripts 03 and 04 --local.
OLLAMA_MODEL=gemma3:270m

# For Gemini, set LLM_PROVIDER=gemini and fill GEMINI_API_KEY instead.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=01-langchain-foundations-revision
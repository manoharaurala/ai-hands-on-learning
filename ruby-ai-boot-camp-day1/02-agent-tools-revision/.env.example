# Copy this file to .env and replace each placeholder with your own value.
# Keep .env local and never commit it.
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Required by scripts 02, 03, and 04. Script 01 does not need Tavily.
TAVILY_API_KEY=tvly-your_tavily_api_key

# Optional LangSmith tracing for any script.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2-your_langsmith_api_key
LANGSMITH_PROJECT=02-agent-tools-revision